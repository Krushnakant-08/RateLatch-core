# PostgreSQL
POSTGRES_USER=rluser
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ratelimiter
DATABASE_URL=postgresql://rluser:changeme@postgres:5432/ratelimiter

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# JWT
JWT_SECRET=your-super-secret-key-change-this

# Default plan limits (overridden per tenant rule)
DEFAULT_FREE_MAX_REQ=100
DEFAULT_FREE_WINDOW_MS=60000
DEFAULT_PRO_MAX_REQ=1000
DEFAULT_PRO_WINDOW_MS=60000
DEFAULT_ENTERPRISE_MAX_REQ=10000
DEFAULT_ENTERPRISE_WINDOW_MS=60000

# Rule cache TTL (seconds)
RULE_CACHE_TTL_SEC=60
PROJECT_KEY_CACHE_TTL_SEC=300

# Upstream proxy timeout (milliseconds)
UPSTREAM_TIMEOUT_MS=10000
